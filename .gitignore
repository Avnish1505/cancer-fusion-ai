# Python virtual environment
venv/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Large model/data files
# Inko Git LFS ya cloud storage par rakhna best hai
# NOTE: models/best_model.pt IS tracked (via Git LFS, see .gitattributes) — it's
# the actual deployed fusion checkpoint. best_model.pth is the stale Phase-1
# (image-only) checkpoint and stays untracked/ignored on purpose.
models/*.pth
data/*.csv

# Frontend dependencies and build output
frontend/node_modules/
frontend/dist/
frontend/.pnp
frontend/.pnp.js

# Test artifacts and logs
/tmp/ham10000_*
.npm/_logs/
*.log

# IDE / Editor specific
.vscode/
.idea/

# macOS
.DS_Store