# Base URL of the Cancer Fusion AI backend API.
# Copy this file to .env (or .env.local) and adjust for local development —
# e.g. VITE_API_BASE_URL=http://127.0.0.1:8000
# If unset, the app falls back to the deployed Railway backend.
VITE_API_BASE_URL=https://cancer-fusion-ai-production.up.railway.app
